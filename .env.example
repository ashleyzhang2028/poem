# 跬步 · 服务端环境变量（由 `node scripts/env-example.js` 生成，**不要手改**）
#
# 全部可选：一个都不配，本站照样能完全离线使用（打开即背）。
# 配齐「必须」两项之后，账号与进度才会真的落到服务端。
#
# 用法：把这份内容复制到托管平台的环境变量里（Vercel / 其它 Node 托管均可）。
#      **不要提交填了真值的 .env**（.gitignore 已经挡着）。
#
# ---------------------------------------------------------------------------
# 必须
# ---------------------------------------------------------------------------
# 会话 Cookie 的签名密钥（至少 16 个字符）
#   缺它：缺它时 /api/* 一律回 503 E_NOT_CONFIGURED —— 「未开放」是如实回答，不是坏掉
#   怎么补：生成一串随机字符（openssl rand -hex 32），填进托管平台的环境变量
SESSION_SECRET=

# Supabase 项目的 URL（形如 https://xxxx.supabase.co）
#   缺它：缺它时自动降级为**内存存储**：本实例重启即丢账号与进度（进程内的假象）
#   怎么补：Supabase 建项目 → Project Settings → API → Project URL
SUPABASE_URL=

# Supabase 的 service_role key（**只在服务端**，绝不进浏览器）
#   缺它：同 SUPABASE_URL：降级为内存存储
#   怎么补：Supabase → Project Settings → API → service_role（不是 anon）
SUPABASE_SERVICE_KEY=

# ---------------------------------------------------------------------------
# 这一件需要
# ---------------------------------------------------------------------------
# SendGrid 的 API key（主选通道）
#   缺它：发不出真邮件；登录链接验证码只能走 ALLOW_CODE_ECHO 冒烟模式手动取
#   怎么补：SendGrid → Settings → API Keys → 建一枚 Mail Send 权限的 key
SENDGRID_API_KEY=

# ---------------------------------------------------------------------------
# 可选
# ---------------------------------------------------------------------------
# 发信通道：sendgrid | resend | console（缺省按「有哪个密钥用哪个」推）
#   缺它：不填也能跑：自动落到 console —— **真实用户收不到信**，只往服务端日志写一行
#   怎么补：二选一填 sendgrid / resend；本地开发不必填
MAIL_TRANSPORT=

# Resend 的 API key（备选通道，与 SendGrid 只备其一）
#   缺它：不影响：SendGrid 能用就用 SendGrid
#   怎么补：Resend → API Keys
RESEND_API_KEY=

# 发信人地址（默认 noreply@mail.kuibu.app）
#   缺它：用默认值；但**域名没做 SPF/DKIM/DMARC 时会被判垃圾邮件**
#   怎么补：在发信商后台验证域名 → 按提示加 SPF / DKIM / DMARC 三条 DNS 记录
MAIL_FROM=

# 发信人显示名（默认「跬步」）
#   缺它：用默认值
#   怎么补：照实填
MAIL_FROM_NAME=

# 站点对外地址（默认 https://kuibu.app），写进邮件正文
#   缺它：用默认值
#   怎么补：填你自己的域名
SITE_URL=

# 密码最短长度（默认 8，按**码点**数）
#   缺它：用默认值 8
#   怎么补：一般不必改。调短会削弱账号安全，调长会把用户挡在注册门外
PASSWORD_MIN=

# 密码最长长度（默认 72）
#   缺它：用默认值 72
#   怎么补：**不要往上调** —— 这不是「防用户填太长」，是防 DoS（超长输入 scrypt 一样要算）
PASSWORD_MAX=

# 邮箱确认链接的有效期（毫秒，默认 24 小时）
#   缺它：用默认值 24 小时
#   怎么补：一般不必改
VERIFY_TTL_MS=

# 重设密码链接的有效期（毫秒，默认 1 小时）
#   缺它：用默认值 1 小时
#   怎么补：重设链接比确认链接短得多 —— 它能直接改掉账号凭据，时效要更紧
RESET_TTL_MS=

# 会话 Cookie 的名字（默认 kbsid）
#   缺它：用默认值
#   怎么补：同域部署多站点时才需要改
COOKIE_NAME=

# 是否允许尝试短信通道（SMS_ENABLED=1 才是「允许」）
#   缺它：默认 0 / 关闭。**开了也不等于能发** —— 还要 SMS_TRANSPORT 指向已实现的商
#   怎么补：签了短信商 + 模板报备通过之后再开（3~7 工作日，日历时间）
SMS_ENABLED=

# 短信商的名字（指向 api/_lib/mail/index.js 里已实现的 transports.<名>）
#   缺它：没有实现可指：只开开关不接商，请求**仍然是 503 E_SMS_NOT_OPEN**（2B 的核心口径）
#   怎么补：先签商 + 模板报备，再实现 transports.<商名>；在此之前这一项**不填**
SMS_TRANSPORT=

# 把明文验证码随响应回给调用方（**只给冒烟自测用**）
#   缺它：默认关闭。生产**绝不许开** —— 开了等于把验证码送给任何调接口的人
#   怎么补：本地联调临时开；上线前确认它是 0
ALLOW_CODE_ECHO=

# 邮箱没确认就不让登录（**默认开**；用户 2026-09-16 在 Issue #197 裁决）
#   缺它：默认 1 / 开着 —— 这正是要的口径。设成 0 才关掉这道闸
#   怎么补：只在「发信商还没配好、确认邮件送不到真实收件箱」的实例上显式设 0。关口诀：**必须同时**把 MAIL_TRANSPORT 配成能真发的通道，否则这道闸 开着就是「谁也别想用」—— 而且界面会如实显示「这台服务器现在没能把确认邮件发出去」；关掉时界面也会如实说「这台服务器没有拦确认」，不会假装拦着
REQUIRE_EMAIL_VERIFIED=
